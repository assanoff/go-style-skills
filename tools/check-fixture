#!/usr/bin/env bash
# check-fixture — run the go-style linters on a fresh copy of evals/fixture and
# score the report against evals/expected.json; exit 1 when it misses a threshold.
#
#   tools/check-fixture                       default thresholds (as in CI)
#   tools/check-fixture --min-lint-recall 1   any score.py flag overrides them
#
# The run is linter-only (--no-llm), so it is deterministic for one golangci-lint
# version. Needs go, python3 and golangci-lint v2.14+.
set -eu

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
engine="$root/plugins/go-style/skills/go-style"

command -v golangci-lint >/dev/null 2>&1 || {
    echo "check-fixture: golangci-lint not found (go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest)" >&2
    exit 1
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cp -R "$root/evals/fixture" "$work/fixture"
cd "$work/fixture"
# The report goes to a store of its own, not to the one in the home directory.
export GO_STYLE_HOME="$work/store"

python3 "$engine/scripts/gostyle.py" prepare --guides all --no-llm
python3 "$engine/scripts/gostyle.py" report
python3 "$root/evals/score.py" "$GO_STYLE_HOME"/reports/example.com/inventory/*.json \
    --expected "$root/evals/expected.json" --min-lint-recall 0.97 --max-unexpected 0 "$@"
