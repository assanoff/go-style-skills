#!/usr/bin/env bash
# package — build dist/go-style-<version>.zip: the go-style skill as one
# self-contained directory, for places that take a skill as a zip (a skill
# marketplace, an upload) and not as a plugin.
#
#   tools/package
#
# The zip holds go-style/ with SKILL.md, the engine and the rule catalogs, plus
# the legal files of the plugin: the catalogs are adapted from the style guides
# and may not be passed on without NOTICE and the licenses. The per-guide skills
# are left out, since they need the engine next to them; in the standalone skill
# `--guides` selects a guide.
set -eu

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
plugin="$root/plugins/go-style"
version="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' \
    "$plugin/.claude-plugin/plugin.json")"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
cp -R "$plugin/skills/go-style" "$work/go-style"
cp -R "$plugin/LICENSE" "$plugin/NOTICE" "$plugin/LICENSES" "$work/go-style/"
find "$work" \( -name __pycache__ -o -name .DS_Store \) -prune -exec rm -rf {} +

# The copy must work on its own: no file of it may reach outside go-style/.
PYTHONDONTWRITEBYTECODE=1 python3 "$work/go-style/scripts/gostyle.py" validate >/dev/null

mkdir -p "$root/dist"
out="$root/dist/go-style-$version.zip"
rm -f "$out"
(cd "$work" && python3 -m zipfile -c "$out" go-style)
echo "$out: $(python3 -m zipfile -l "$out" | grep -c -v '/$') files"
